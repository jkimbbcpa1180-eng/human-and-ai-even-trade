+def _toy_world(n: int = 4, polity: str = "Demo"):
+    """n registered people, one bound pod each; pod-0 is a mutual neighbor of
+    every other pod. Returns (registry, clock, graph, pods)."""
+    registry = PersonhoodRegistry(pepper=b"toy-pepper-not-secret")
+    members = [(f"person-{i}", f"toy-bio-{i}") for i in range(n)]
+    if registry.register_genesis(members)["status"] != "GENESIS":
+        raise ValueError("toy genesis failed")
+    clock, graph, pods = LedgerClock(), NeighborGraph(), []
+    for i, (pid, _) in enumerate(members):
+        pod = HouseholdPod(f"pod-{i}", person_id=pid, polity=polity)
+        registry.bind_pod(pid, pod.node_id)
+        graph.register_pod(pod.node_id)
+        pods.append(pod)
+    for pod in pods[1:]:
+        graph.link(pods[0].node_id, pod.node_id)
+    return registry, clock, graph, pods
+
