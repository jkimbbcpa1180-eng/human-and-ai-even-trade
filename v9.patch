+# 6b. BasicNeedsPool (v9) — physical basics, separate from TC
+# ===========================================================================
+class BasicNeedsPool:
+    """Physical inventory, accounted separately from TC, in four integer
+    units: food kcal, water ml, energy Wh and shelter person-days. Every
+    active registered person gets an equal share each ledger day. It never
+    looks at work, sensor data, contribution scores, sponsors, pods or TC
+    balances. Integer remainders rotate between people by day; shortages
+    are reported, not hidden.
+
+    Limits (labeled): daily targets are caller-chosen policy numbers, NOT
+    nutrition, medical or engineering advice; calories are not a complete
+    diet; deposits must be supplies actually available net of production
+    and infrastructure use; shelter person-days are available capacity,
+    not new housing; an allocation record is NOT proof that goods reached
+    anyone. Equal-per-person is illustrative; a real system needs
+    needs-based accommodations, emergency priorities and appeals. Being in
+    the registry is still an administrative gate. Spoilage, procurement,
+    grid dispatch, water safety and occupancy are not modeled."""
+    UNITS = ("food_kcal", "water_ml", "energy_wh", "shelter_person_days")
+
+    def __init__(self, registry: PersonhoodRegistry, clock: LedgerClock,
+                 daily_targets: Dict[str, int]):
+        self.registry, self.clock = registry, clock
+        self.targets = self._basket(daily_targets)
+        self._stock = dict.fromkeys(self.UNITS, 0)
+        self._deposits: Dict[str, Dict] = {}
+        self._days: Dict[int, Dict] = {}
+
+    @classmethod
+    def _basket(cls, basket: Dict[str, int]) -> Dict[str, int]:
+        if set(basket) != set(cls.UNITS):
+            raise ValueError("provide exactly the four resource units")
+        return {k: _integer(basket[k], k) for k in cls.UNITS}
+
+    @property
+    def inventory(self) -> Dict[str, int]:
+        return dict(self._stock)
+
+    def deposit(self, receipt_id: str, basket: Dict[str, int],
+                source: str) -> None:
+        if not isinstance(receipt_id, str) or not receipt_id.strip():
+            raise ValueError("supply receipt ID required")
+        if not isinstance(source, str) or not source.strip():
+            raise ValueError("supply source label required")
+        basket = self._basket(basket)
+        if receipt_id in self._deposits:
+            raise ValueError("duplicate supply receipt")
+        self._deposits[receipt_id] = {"basket": basket, "source": source}
+        for k, v in basket.items():
+            self._stock[k] += v
+
+    def allocate_today(self) -> Dict:
+        """Once per ledger day; later calls return a copy of the same record."""
+        day = _integer(self.clock.hour, "clock hour") // 24
+        if day in self._days:
+            return copy.deepcopy(self._days[day])
+        people = sorted(pid for pid in self.registry.persons
+                        if self.registry.is_active_member(pid))
+        if not people:
+            return {"day": day, "status": "NO_RESIDENTS", "allocations": {}}
+        offset = day % len(people)          # rotate remainder priority
+        people = people[offset:] + people[:offset]
+        n = len(people)
+        allocations: Dict[str, Dict[str, int]] = {p: {} for p in people}
+        shortfall, used = {}, {}
+        for res in self.UNITS:
+            required = self.targets[res] * n
+            available = min(self._stock[res], required)
+            q, r = divmod(available, n)
+            for i, person in enumerate(people):
+                allocations[person][res] = q + int(i < r)
+            used[res] = available
+            shortfall[res] = required - available
+            self._stock[res] -= available
+        result = {"day": day,
+                  "status": "SHORTFALL" if any(shortfall.values()) else "ALLOCATED",
+                  "allocations": allocations, "shortfall": shortfall,
+                  "used": used, "remaining": self.inventory,
+                  "note": "allocation record, not verified delivery"}
+        self._days[day] = copy.deepcopy(result)
+        return result
 
 
