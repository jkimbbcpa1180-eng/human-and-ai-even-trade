+def _finite(value, name: str, minimum: float = 0, maximum: Optional[float] = None):
+    """v9 input check: a real, finite number in [minimum, maximum]."""
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ValueError(f"{name} must be numeric")
+    if not math.isfinite(value) or value < minimum:
+        raise ValueError(f"{name} must be finite and >= {minimum}")
+    if maximum is not None and value > maximum:
+        raise ValueError(f"{name} must be <= {maximum}")
+    return value
+
+
+def _integer(value, name: str, minimum: int = 0) -> int:
+    if type(value) is not int or value < minimum:
+        raise ValueError(f"{name} must be an integer >= {minimum}")
+    return value
+
+
+def _cents(value: float) -> int:
+    """Credits -> integer cents, rounded down (no float drift in caps)."""
+    _finite(value, "credits")
+    return int((Decimal(str(value)) * 100).to_integral_value(rounding=ROUND_DOWN))
+
 
